          "name": "executionState",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "receiverProgram",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "data",
          "type": "bytes"
        }
      ]
